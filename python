# Программа приветствия пользователя

# Запрашиваем ввод имени пользователя
name = input("Введите ваше имя: ")

# Преобразуем введённое имя к нижнему регистру и делаем первую букву заглавной
formatted_name = name.strip().lower().capitalize()

# Простая проверка возраста пользователя
while True:
    try:
        age = int(input("Сколько Вам лет? "))
        if age <= 0 or age >= 120:
            print("Возраст должен быть реалистичным!")
        else:
            break
    except ValueError:
        print("Некорректный ввод. Попробуйте ещё раз.")

# Выводим персонализированное приветствие
print(f"Приветствуем Вас, {formatted_name}! Вам исполнилось {age} лет.")

# Пример простейшего списка и перебора элементов
favorite_fruits = ["яблоки", "бананы", "груши"]

if favorite_fruits:
    print("\nВам нравятся фрукты:")
    for fruit in favorite_fruits:
        print(f"- {fruit}")
else:
    print("\nФрукты не указаны.")

# Завершение программы
print("\nСпасибо за участие!")
